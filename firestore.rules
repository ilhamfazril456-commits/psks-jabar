rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security validation & anti-bot payload protection
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default global rule: Allow read and write for all collections in the portal
    match /{document=**} {
      allow read, write: if true;
    }
  }
}


