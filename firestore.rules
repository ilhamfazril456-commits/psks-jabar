rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security validation & anti-bot payload protection
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidPahlawanId(id) {
      return id is string && id.matches('^slot_([1-9]|1[0-8])$');
    }

    function isValidPahlawan(data) {
      return data.keys().hasAll(['slotNumber', 'nama', 'biografi', 'fotoBase64', 'updatedAt']) &&
        data.keys().hasOnly([
          'id',
          'slotNumber',
          'nama',
          'gelar',
          'biografi',
          'fotoBase64',
          'fotoSizeKb',
          'originalSizeKb',
          'updatedAt',
          'updatedBy'
        ]) &&
        data.slotNumber is int &&
        data.slotNumber >= 1 &&
        data.slotNumber <= 18 &&
        data.nama is string &&
        data.nama.size() >= 1 &&
        data.nama.size() <= 200 &&
        data.biografi is string &&
        data.biografi.size() >= 1 &&
        data.biografi.size() <= 15000 &&
        data.fotoBase64 is string &&
        data.fotoBase64.size() >= 10 &&
        data.fotoBase64.size() <= 450000 &&
        data.updatedAt is string &&
        data.updatedAt.size() <= 64 &&
        (!('id' in data) || (data.id is string && data.id.size() <= 32)) &&
        (!('gelar' in data) || (data.gelar is string && data.gelar.size() <= 200)) &&
        (!('fotoSizeKb' in data) || (data.fotoSizeKb is number && data.fotoSizeKb >= 0)) &&
        (!('originalSizeKb' in data) || (data.originalSizeKb is number && data.originalSizeKb >= 0)) &&
        (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128));
    }

    // 1. Audit Trail System Logs: STRICT APPEND-ONLY (No one can tamper with or erase logs)
    match /system_logs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId);
      allow update, delete: if false;
    }

    // 2. Security Signals: Forensics & real-time live signal updates
    match /security_signals/{signalId} {
      allow read: if true;
      allow create, update: if isValidId(signalId);
      allow delete: if false;
    }

    // 3. User, Admin, Superadmin, & Dev Accounts (Zero plaintext secrets allowed in Firestore)
    match /dev_accounts/{devId} {
      allow read: if true;
      allow create, update: if isValidId(devId) &&
        !('passwordPolos' in request.resource.data) &&
        !('superadminPin' in request.resource.data) &&
        !('developerPin' in request.resource.data);
      allow delete: if false; // Developer root account cannot be deleted
    }

    match /superadmin_accounts/{superadminId} {
      allow read: if true;
      allow create, update: if isValidId(superadminId) &&
        !('passwordPolos' in request.resource.data) &&
        !('superadminPin' in request.resource.data) &&
        !('developerPin' in request.resource.data);
      allow delete: if isValidId(superadminId) && superadminId != 'adm-super';
    }

    match /admin_accounts/{accountId} {
      allow read: if true;
      allow create, update: if isValidId(accountId) &&
        !('passwordPolos' in request.resource.data) &&
        !('superadminPin' in request.resource.data) &&
        !('developerPin' in request.resource.data);
      allow delete: if isValidId(accountId) && accountId != 'adm-dev' && accountId != 'adm-super';
    }

    match /user_accounts/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) &&
        !('passwordPolos' in request.resource.data) &&
        !('superadminPin' in request.resource.data) &&
        !('developerPin' in request.resource.data);
      allow delete: if isValidId(userId);
    }

    // 4. Global App Settings: Protected against deletion & secret PIN tampering
    match /app_settings/{settingId} {
      allow read: if true;
      allow create, update: if isValidId(settingId) && !('superadminPin' in request.resource.data) && !('developerPin' in request.resource.data);
      allow delete: if false;
    }

    // 5. IP Registrations: Anti-spoofing device binding
    match /ip_registrations/{ipId} {
      allow read: if true;
      allow create, update: if isValidId(ipId);
      allow delete: if false;
    }

    // 6. 10 Pilar Social Data Records
    match /psks_records/{recordId} {
      allow read: if true;
      allow create, update, delete: if isValidId(recordId);
    }

    match /psks_records_meta/{metaId} {
      allow read: if true;
      allow create, update: if isValidId(metaId);
      allow delete: if false;
    }

    // 7. Pendaftaran Mandiri Anggota PSKS (Registration Submissions)
    match /registration_submissions/{submissionId} {
      allow read: if true;
      allow create, update: if isValidId(submissionId);
      allow delete: if isValidId(submissionId);
    }

    // 8. Manajemen Agenda & Tugas Wilayah
    match /task_items/{taskId} {
      allow read: if true;
      allow create, update, delete: if isValidId(taskId);
    }

    // 9. Repositori Dokumen & Surat Tugas
    match /document_repository/{docId} {
      allow read: if true;
      allow create, update, delete: if isValidId(docId);
    }

    // 10. Kotak Pesan Internal Petugas & Notifikasi
    match /admin_messages/{messageId} {
      allow read: if true;
      allow create, update, delete: if isValidId(messageId);
    }

    // 11. Public Informational Content (Regional Logos & Portal FAQs)
    match /psks_regional_logos/{logoId} {
      allow read: if true;
      allow create, update, delete: if isValidId(logoId);
    }

    match /portal_faqs/{faqId} {
      allow read: if true;
      allow create, update, delete: if isValidId(faqId);
    }

    // 12. AI Dynamic Knowledge Base & Brain Storage
    match /ai_knowledge_base/{docId} {
      allow read: if true;
      allow create, update, delete: if isValidId(docId);
    }

    match /ai_knowledge/{docId} {
      allow read: if true;
      allow create, update, delete: if isValidId(docId);
    }

    match /ai_config/{docId} {
      allow read: if true;
      allow create, update, delete: if isValidId(docId);
    }

    match /ai_vocabulary/{docId} {
      allow read: if true;
      allow create, update, delete: if isValidId(docId);
    }

    match /ai_brain/{docId} {
      allow read: if true;
      allow create, update, delete: if isValidId(docId);
    }

    match /ai_unmatched_logs/{docId} {
      allow read: if true;
      allow create, update, delete: if isValidId(docId);
    }

    // 13. Video Background Sync
    match /system_video_chunks/{chunkId} {
      allow read: if true;
      allow create, update, delete: if isValidId(chunkId);
    }

    match /sync_video/{videoId} {
      allow read, write: if isValidId(videoId);
    }

    // 14. Galeri 18 Pahlawan Nasional (Dapat dibaca realtime semua pengguna, validasi skema ketat)
    match /pahlawan_nasional/{heroId} {
      allow read: if true;
      allow create, update: if isValidPahlawanId(heroId) && isValidPahlawan(request.resource.data);
      allow delete: if isValidPahlawanId(heroId);
    }

    // 15. Default Deny Catch-All: Block any unlisted or arbitrary paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
