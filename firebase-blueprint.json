{
  "entities": {
    "admin_accounts": {
      "title": "Admin Accounts",
      "description": "Daftar akun admin regional dan superadmin SIM-PSKS Jawa Barat",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "namaAdmin": { "type": "string" },
        "wilayahTugas": { "type": "string" },
        "role": { "type": "string" },
        "passwordPolos": { "type": "string" },
        "terakhirLogin": { "type": "string" }
      },
      "required": ["username", "wilayahTugas", "role"]
    },
    "psks_records": {
      "title": "PSKS Records",
      "description": "Data record personil 12 Pilar PSKS se-Jawa Barat",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "pillarId": { "type": "string" },
        "nama": { "type": "string" },
        "nik": { "type": "string", "maxLength": 16, "minLength": 16, "pattern": "^[0-9]{16}$" },
        "jenisKelamin": { "type": "string" },
        "pendidikan": { "type": "string" },
        "noTglSertifikasi": { "type": "string" },
        "sertifikasiKompetensi": { "type": "string" },
        "jenjangJabatan": { "type": "string" },
        "tempatBertugas": { "type": "string" },
        "instansiBertugas": { "type": "string" },
        "statusPeksos": { "type": "string" },
        "jenjangJabatanPemerintah": { "type": "string" },
        "wilayah": { "type": "string" },
        "kec": { "type": "string" },
        "kelDesa": { "type": "string" },
        "alamat": { "type": "string" },
        "hp": { "type": "string" },
        "predikatTerakhir": { "type": "string" },
        "noTglSertifikatKompetensi": { "type": "string" },
        "masaBerlakuSk": { "type": "string" },
        "noSkKeanggotaan": { "type": "string" },
        "statusKeaktifan": { "type": "string" },
        "email": { "type": "string" },
        "nomorKontak": { "type": "string" },
        "bimtekDiikuti": { "type": "string" },
        "sertifikasi": { "type": "string" },
        "lembaga": { "type": "string" },
        "status": { "type": "string" },
        "masaBakti": { "type": "string" },
        "noSk": { "type": "string" },
        "statusAktif": { "type": "string" },
        "nomorInduk": { "type": "string" },
        "sertifikat": { "type": "string" },
        "keahlian": { "type": "string" },
        "pelatihan": { "type": "string" },
        "namaLks": { "type": "string" },
        "bidangPelayanan": { "type": "string" },
        "ketua": { "type": "string" },
        "nomorTandaDaftar": { "type": "string" },
        "masaBerlaku": { "type": "string" },
        "namaKarangTaruna": { "type": "string" },
        "tahunBerdiri": { "type": "string" },
        "namaLk3": { "type": "string" },
        "kontak": { "type": "string" },
        "jenisLayanan": { "type": "string" },
        "instansi": { "type": "string" },
        "jabatan": { "type": "string" },
        "wilayahKerja": { "type": "string" },
        "skPengangkatan": { "type": "string" },
        "masaTugas": { "type": "string" },
        "namaBadanUsaha": { "type": "string" },
        "jenisUsaha": { "type": "string" },
        "bentukCsr": { "type": "string" },
        "bidangBantuan": { "type": "string" },
        "namaSlrt": { "type": "string" },
        "operator": { "type": "string" }
      },
      "required": ["pillarId", "nama", "nik", "wilayah"]
    },
    "app_settings": {
      "title": "App Settings",
      "description": "Konfigurasi global sistem (Video Background, Foto Kadinas, Social Links, Floating WA, dan Mode Maintenance)",
      "type": "object",
      "properties": {
        "bgVideoUrl": { "type": "string" },
        "kadinasPhotoUrl": { "type": "string" },
        "floatingWaNumber": { "type": "string" },
        "socialLinks": { "type": "object" },
        "maintenanceUser": { "type": "boolean" },
        "maintenanceAdmin": { "type": "boolean" },
        "maintenanceSuperadmin": { "type": "boolean" },
        "maintenanceMsgUser": { "type": "string" },
        "maintenanceMsgAdmin": { "type": "string" },
        "maintenanceMsgSuperadmin": { "type": "string" }
      }
    },
    "system_video_chunks": {
      "title": "System Video Chunks",
      "description": "Potongan data multi-part video latar belakang untuk sinkronisasi realtime",
      "type": "object",
      "properties": {
        "index": { "type": "number" },
        "data": { "type": "string" },
        "updatedAt": { "type": "number" }
      }
    },
    "registration_submissions": {
      "title": "Registration Submissions",
      "description": "Antrean verifikasi pendaftaran mandiri anggota 10 Pilar PSKS",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "pillarId": { "type": "string" },
        "wilayah": { "type": "string" },
        "nama": { "type": "string" },
        "nik": { "type": "string" },
        "hp": { "type": "string" },
        "status": { "type": "string" },
        "submittedAt": { "type": "string" }
      },
      "required": ["pillarId", "wilayah", "nama", "status"]
    },
    "task_items": {
      "title": "Task Items",
      "description": "Daftar penugasan operasional dan instruksi kerja wilayah dari Superadmin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "targetWilayah": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string" },
        "assignedBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "targetWilayah", "priority", "status", "assignedBy"]
    },
    "security_signals": {
      "title": "Security Signals",
      "description": "Sinyal instan aksi keamanan (Freeze, Delete, Password Reset) untuk penegakan otorisasi realtime",
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "targetUsername": { "type": "string" },
        "targetId": { "type": "string" },
        "targetWilayah": { "type": "string" },
        "timestamp": { "type": "number" },
        "by": { "type": "string" }
      }
    },
    "ai_knowledge_base": {
      "title": "AI Knowledge Base",
      "description": "Pangkalan data basis pengetahuan cerdas asisten AI seputar 10 pilar PSKS, SOP penugasan, regulasi, dan layanan Dinas Sosial Jawa Barat",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "topic": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string" },
        "content": { "type": "string" },
        "actionTag": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["topic", "title", "category", "content"]
    },
    "ai_config": {
      "title": "AI Brain & System Configuration",
      "description": "Otak dan konfigurasi instruksi sistem asisten AI, aturan konteks obrolan, dan contoh simulasi yang tersimpan di Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "systemInstruction": { "type": "string" },
        "contextRules": { "type": "string" },
        "dialogueExamples": { "type": "string" },
        "vocabularySummary": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["systemInstruction"]
    },
    "ai_vocabulary": {
      "title": "AI Vocabulary & Dialect Normalizer",
      "description": "Kamus kosakata baku, non-baku, bahasa Sunda, singkatan, dan slang untuk pemahaman konteks percakapan asisten AI",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "word": { "type": "string" },
        "canonical": { "type": "string" },
        "category": { "type": "string" },
        "intent": { "type": "string" }
      },
      "required": ["word", "canonical"]
    },
    "ip_registrations": {
      "title": "IP & Device Registration Quota",
      "description": "Pelacakan kuota pendaftaran akun secara realtime per alamat IP dan perangkat (maksimal 3 akun per IP/perangkat)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "identifier": { "type": "string" },
        "type": { "type": "string" },
        "registeredAccounts": { "type": "array", "items": { "type": "string" } },
        "count": { "type": "number" },
        "updatedAt": { "type": "string" },
        "lastRegisteredAt": { "type": "string" }
      },
      "required": ["identifier", "registeredAccounts", "count"]
    },
    "portal_faqs": {
      "title": "Portal FAQs Collection",
      "description": "Daftar tanya jawab resmi portal PSKS Jawa Barat yang dapat dikelola oleh Superadmin dan Developer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "question": { "type": "string" },
        "answer": { "type": "string" },
        "category": { "type": "string" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "updatedBy": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "question", "answer", "category", "order", "isActive"]
    },
    "document_repository": {
      "title": "Document Repository & Regulation Center",
      "description": "Repositori resmi berkas regulasi Kemensos RI, Pergub Jabar, SOP 10 Pilar PSKS, dan formulir blanko kedinasan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "nomorRegulasi": { "type": "string" },
        "tahun": { "type": "number" },
        "tanggalDitetapkan": { "type": "string" },
        "instansi": { "type": "string" },
        "description": { "type": "string" },
        "fileSize": { "type": "string" },
        "pageCount": { "type": "number" },
        "status": { "type": "string" },
        "downloadCount": { "type": "number" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "fileType": { "type": "string" },
        "pdfType": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id", "title", "category", "nomorRegulasi", "status"]
    }
  },
  "firestore": {
    "/admin_accounts/{accountId}": {
      "schema": "admin_accounts",
      "description": "Akun administrator wilayah dan superadmin"
    },
    "/psks_records/{recordId}": {
      "schema": "psks_records",
      "description": "Data record personil 12 Pilar PSKS se-Jawa Barat"
    },
    "/app_settings/{documentId}": {
      "schema": "app_settings",
      "description": "Konfigurasi global sistem"
    },
    "/system_video_chunks/{chunkId}": {
      "schema": "system_video_chunks",
      "description": "Potongan video background realtime"
    },
    "/registration_submissions/{submissionId}": {
      "schema": "registration_submissions",
      "description": "Antrean verifikasi pendaftaran mandiri anggota 10 Pilar PSKS"
    },
    "/task_items/{taskId}": {
      "schema": "task_items",
      "description": "Daftar penugasan operasional wilayah dari Superadmin"
    },
    "/security_signals/{signalId}": {
      "schema": "security_signals",
      "description": "Sinyal instan aksi keamanan"
    },
    "/ai_knowledge_base/{docId}": {
      "schema": "ai_knowledge_base",
      "description": "Pangkalan data basis pengetahuan cerdas asisten AI"
    },
    "/ai_config/{configId}": {
      "schema": "ai_config",
      "description": "Otak dan konfigurasi instruksi sistem asisten AI"
    },
    "/ai_vocabulary/{vocabId}": {
      "schema": "ai_vocabulary",
      "description": "Kamus kosakata baku dan non-baku asisten AI"
    },
    "/ip_registrations/{ipDocId}": {
      "schema": "ip_registrations",
      "description": "Pelacakan kuota pendaftaran akun per IP/perangkat"
    },
    "/portal_faqs/{faqId}": {
      "schema": "portal_faqs",
      "description": "Daftar tanya jawab resmi portal PSKS Jawa Barat"
    },
    "/document_repository/{docId}": {
      "schema": "document_repository",
      "description": "Repositori resmi berkas regulasi Kemensos RI, Pergub Jabar, SOP dan blanko"
    }
  }
}
